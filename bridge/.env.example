# 必须配 — 从 xiaozhi.me 控制台拿:
#   智能体 → 配置角色 → MCP 设置 → 自定义服务 → 获取 MCP 接入点
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN_HERE

# 可选 — claude 命令路径（默认 ~/.local/bin/claude）
# CLAUDE_BIN=/usr/local/bin/claude

# 可选 — Claude Code 的工作目录，决定加载哪个项目的 CLAUDE.md / memory
# 默认 ~（用全局 ~/.claude/）；可改成你主要工作的项目目录
# CLAUDE_BRIDGE_WORKDIR=/Users/you/Projects/mywork

# ─────────────────────────────────────────────────────────────────────────────
# Mac → 设备 主动推送 (stackchan_push.py: speak / express / gesture)
# Mac 端主动让机器人说话/换表情/点头。需要设备已刷入 LAN 控制固件 (Path A2)。
# ─────────────────────────────────────────────────────────────────────────────

# 必须 — 设备的局域网 IP（建议在路由器上做 DHCP 保留，或用 mDNS）
SC_DEVICE_IP=192.168.0.50
# 必须 — 与固件共享的认证 token（每个请求都带上；不要提交真值）
SC_TOKEN=CHANGE_ME_SHARED_SECRET

# 可选 — 设备 LAN WebSocket 端口 / 路径（默认 8080 /ws，与固件契约一致）
# SC_DEVICE_PORT=8080
# SC_DEVICE_WS_PATH=/ws

# 可选 — Mac 的局域网 IP（写进设备来拉音频的 URL）。默认自动探测：
#   会优先选与 SC_DEVICE_IP 同网段的网卡，避开 VPN/utun。开了 VPN 建议显式写死。
# SC_MAC_IP=192.168.0.219
# 可选 — Mac 上临时 HTTP 文件服务端口 + 目录（默认 8790 /tmp/sc）
# SC_SERVE_PORT=8790
# SC_SERVE_DIR=/tmp/sc

# 可选 — Opus 音频格式，必须与固件解码器一致（默认 16kHz 单声道 60ms 帧）。
#   固件 PR 定稿后如需改，这里一行即可对齐。
# SC_OPUS_RATE=16000
# SC_OPUS_FRAME_MS=60

# 可选 — macOS `say` 的音色（中文可用 Meijia / Tingting；默认系统音色）
# SC_TTS_VOICE=Meijia
